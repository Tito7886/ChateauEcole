<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChateauEcole.Core\ChateauEcole.Core.csproj" />
  </ItemGroup>

  <!-- world.json est EMBARQUÉ dans l'exe (fichier unique portable). Program.cs le lit depuis
       la ressource embarquée, sauf si un world.json est posé À CÔTÉ de l'exe (override sans
       recompiler). LogicalName fixe pour une recherche déterministe. -->
  <ItemGroup>
    <EmbeddedResource Include="world.json">
      <LogicalName>world.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
