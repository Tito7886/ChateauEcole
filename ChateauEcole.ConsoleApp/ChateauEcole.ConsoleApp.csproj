<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Icône de l'exe (visible dans l'Explorateur / barre des tâches). Remplace icon.ico
         par la tienne (même nom) puis republie. Fonctionne aussi en single-file. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChateauEcole.Core\ChateauEcole.Core.csproj" />
  </ItemGroup>

  <!-- world.json (FR source) et ses traductions sont embarqués dans l'exe (fichier unique).
       Les traductions sont nommées avec un UNDERSCORE (world_en.json, world_pl.json...) :
       ainsi .NET ne les prend jamais pour des cultures « en »/« pl » (sinon elles finissent
       dans des assemblys satellites et le jeu retombe sur le français).
       Ajouter une langue = ajouter une ligne ici (ex. world_it.json). -->
  <ItemGroup>
    <EmbeddedResource Include="world.json"><LogicalName>world.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="world_en.json"><LogicalName>world_en.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="world_pl.json"><LogicalName>world_pl.json</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!-- Traductions de l'INTERFACE (menus, prompts, mini-jeux) : français = clé + repli.
       Même règle d'UNDERSCORE que les mondes (ui_en.json, ui_pl.json...) pour éviter les
       assemblys satellites. Ajouter une langue = ajouter une ligne ici (ex. ui_it.json). -->
  <ItemGroup>
    <EmbeddedResource Include="ui_en.json"><LogicalName>ui_en.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="ui_pl.json"><LogicalName>ui_pl.json</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
