<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Icône de l'exe (visible dans l'Explorateur / barre des tâches). Remplace icon.ico
         par la tienne (même nom) puis republie. Fonctionne aussi en single-file. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChateauEcole.Core\ChateauEcole.Core.csproj" />
  </ItemGroup>

  <!-- world.json (FR source) ET ses traductions sont embarqués dans l'exe (fichier unique).
       IMPORTANT : WithCulture=false, sinon .NET prend « en »/« pl »/« it » pour des CULTURES et
       met les fichiers dans des assemblys satellites (dossiers en/, pl/...) au lieu de la DLL.
       Chacun garde son nom comme LogicalName ; Program.cs charge la langue choisie (repli world.json).
       Ajouter une langue = ajouter une ligne ici (ex. world.it.json). -->
  <ItemGroup>
    <EmbeddedResource Include="world.json"><WithCulture>false</WithCulture><LogicalName>world.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="world.en.json"><WithCulture>false</WithCulture><LogicalName>world.en.json</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="world.pl.json"><WithCulture>false</WithCulture><LogicalName>world.pl.json</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
